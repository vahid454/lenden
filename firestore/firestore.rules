rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isOptionalString(field) {
      return !(field in request.resource.data) || request.resource.data[field] is string;
    }
    function isOptionalTimestamp(field) {
      return !(field in request.resource.data) || request.resource.data[field] is timestamp;
    }
    function hasVerifiedPhone(phoneE164) {
      return isSignedIn()
          && request.auth.token.phone_number is string
          && request.auth.token.phone_number == phoneE164;
    }
    function canReadSharedLedger(customerId) {
      return exists(/databases/$(database)/documents/sharedLedgers/$(customerId))
          && hasVerifiedPhone(
            get(/databases/$(database)/documents/sharedLedgers/$(customerId)).data.phoneE164
          );
    }
    function hasValidCustomerFields() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'name',
          'phone',
          'secondaryPhone',
          'address',
          'ledgerPurpose',
          'notes',
          'photoPath',
          'ownerName',
          'ownerPhone',
          'balance',
          'createdAt',
          'updatedAt',
          'nameLower',
          'namePrefix',
          'isDefaulter',
          'defaulterNote',
          'defaulterMarkedAt',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && isOptionalString('secondaryPhone')
        && (!('secondaryPhone' in request.resource.data)
            || request.resource.data.secondaryPhone.matches('^[6-9][0-9]{9}$'))
        && isOptionalString('address')
        && isOptionalString('ledgerPurpose')
        && (!('ledgerPurpose' in request.resource.data)
            || request.resource.data.ledgerPurpose.size() <= 120)
        && isOptionalString('notes')
        && isOptionalString('photoPath')
        && isOptionalString('ownerName')
        && isOptionalString('ownerPhone')
        && (!('isDefaulter' in request.resource.data)
            || request.resource.data.isDefaulter is bool)
        && isOptionalString('defaulterNote')
        && (!('defaulterNote' in request.resource.data)
            || request.resource.data.defaulterNote.size() <= 500)
        && isOptionalTimestamp('defaulterMarkedAt')
        && request.resource.data.balance is number;
    }
    function hasValidSharedLedgerFields() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'name',
          'phone',
          'phoneE164',
          'address',
          'ledgerPurpose',
          'ownerName',
          'ownerPhone',
          'balance',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.phoneE164 == '+91' + request.resource.data.phone
        && isOptionalString('address')
        && isOptionalString('ledgerPurpose')
        && (!('ledgerPurpose' in request.resource.data)
            || request.resource.data.ledgerPurpose.size() <= 120)
        && isOptionalString('ownerName')
        && isOptionalString('ownerPhone')
        && request.resource.data.balance is number
        && request.resource.data.createdAt is timestamp
        && isOptionalTimestamp('updatedAt');
    }
    function hasValidTransactionFields() {
      return request.resource.data.keys().hasOnly([
          'customerId',
          'userId',
          'amount',
          'type',
          'note',
          'date',
          'createdAt',
          'yearMonth',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.type in ['gave', 'got']
        && isOptionalString('note')
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt is timestamp;
    }
    function hasValidCashbookFields() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'type',
          'amount',
          'note',
          'date',
          'createdAt',
          'yearMonthDay',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.type in ['in', 'out']
        && isOptionalString('note')
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.yearMonthDay is string;
    }
    function hasValidPaymentPromiseFields() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'customerId',
          'amount',
          'fulfilledAmount',
          'promisedDate',
          'status',
          'note',
          'lastContactedAt',
          'followUpNote',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.fulfilledAmount is number
        && request.resource.data.fulfilledAmount >= 0
        && request.resource.data.fulfilledAmount <= request.resource.data.amount
        && request.resource.data.promisedDate is timestamp
        && request.resource.data.status in ['pending', 'partialPaid', 'paid', 'missed', 'rescheduled', 'cancelled']
        && isOptionalString('note')
        && isOptionalString('followUpNote')
        && isOptionalTimestamp('lastContactedAt')
        && request.resource.data.createdAt is timestamp;
    }
    function hasReservedCustomerPhone(customerId) {
      let key = request.auth.uid + '_' + request.resource.data.phone;
      return existsAfter(/databases/$(database)/documents/customerPhoneKeys/$(key))
          && getAfter(/databases/$(database)/documents/customerPhoneKeys/$(key)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/customerPhoneKeys/$(key)).data.phone == request.resource.data.phone
          && getAfter(/databases/$(database)/documents/customerPhoneKeys/$(key)).data.customerId == customerId;
    }
    function hasDeterministicCustomerId(customerId) {
      return customerId == request.auth.uid + '_' + request.resource.data.phone;
    }
    function hasValidCustomerPhotoPath(customerId) {
      return !('photoPath' in request.resource.data)
          || request.resource.data.photoPath == 'users/' + request.auth.uid
              + '/customers/' + customerId + '/profile.jpg';
    }
    function hasConsistentPaymentPromiseStatus() {
      return (request.resource.data.status == 'pending'
              && request.resource.data.fulfilledAmount == 0)
          || (request.resource.data.status == 'partialPaid'
              && request.resource.data.fulfilledAmount > 0
              && request.resource.data.fulfilledAmount < request.resource.data.amount)
          || (request.resource.data.status == 'paid'
              && request.resource.data.fulfilledAmount > 0
              && request.resource.data.fulfilledAmount <= request.resource.data.amount)
          || request.resource.data.status in ['missed', 'rescheduled', 'cancelled'];
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Customers ─────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && hasValidCustomerFields()
                    && hasValidCustomerPhotoPath(customerId)
                    && hasDeterministicCustomerId(customerId);
      allow update: if isSignedIn()
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && (request.resource.data.phone == resource.data.phone
                          || hasReservedCustomerPhone(customerId))
                      && hasValidCustomerPhotoPath(customerId)
                      && hasValidCustomerFields();
      allow delete: if false;
    }

    // Sanitized customer-facing ledger. Private notes and collection-risk
    // metadata stay exclusively in /customers.
    match /sharedLedgers/{customerId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || hasVerifiedPhone(resource.data.phoneE164));
      allow create: if isSignedIn() && hasValidSharedLedgerFields();
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && hasValidSharedLedgerFields();
      allow delete: if false;
    }

    // ── Customer phone uniqueness ─────────────────────────────────────────
    // A deterministic reservation makes each primary phone unique per owner.
    match /customerPhoneKeys/{phoneKey} {
      allow get: if isSignedIn()
                 && phoneKey.matches('^' + request.auth.uid + '_[6-9][0-9]{9}$');
      allow list: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                      'userId', 'phone', 'customerId', 'createdAt'
                    ])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
                    && request.resource.data.customerId is string
                    && request.resource.data.customerId.size() > 0
                    && request.resource.data.createdAt is timestamp
                    && phoneKey == request.auth.uid + '_' + request.resource.data.phone;
      allow update, delete: if false;
    }

    // ── Transactions ──────────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read:   if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || canReadSharedLedger(resource.data.customerId));
      allow create: if isSignedIn()
                      && hasValidTransactionFields()
                      && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
                      && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.userId == request.auth.uid;
      allow update: if isSignedIn()
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.customerId == resource.data.customerId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && hasValidTransactionFields();
      allow delete: if false;
    }

    // ── Cashbook ──────────────────────────────────────────────────────────
    match /cashbook/{entryId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && hasValidCashbookFields();
      allow update: if false;
      allow delete: if false;
    }

    // ── Payment Promises ──────────────────────────────────────────────────
    // Promise documents are history. Rescheduling creates a fresh document;
    // the original is retained with a terminal status.
    match /paymentPromises/{promiseId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && hasValidPaymentPromiseFields()
                    && hasConsistentPaymentPromiseStatus()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.fulfilledAmount == 0
                    && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
                    && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.customerId == resource.data.customerId
                    && request.resource.data.amount == resource.data.amount
                    && request.resource.data.promisedDate == resource.data.promisedDate
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (request.resource.data.status != 'cancelled'
                        || resource.data.status == 'pending')
                    && (resource.data.status != 'cancelled'
                        || request.resource.data.status == 'cancelled')
                    && hasValidPaymentPromiseFields()
                    && hasConsistentPaymentPromiseStatus();
      allow delete: if false;
    }
  }
}
